{
  "manifest_version": 3,
  "name": "NUTS: No Unwanted Tabs or Swaps",
  "short_name": "NUTS",
  "version": "1.3.0",
  "description": "One switch. While it is on, pages cannot open new tabs or swap your tab for another site.",
  "minimum_chrome_version": "110",
  "permissions": ["storage", "webNavigation"],
  "host_permissions": ["<all_urls>"],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["site.js", "content.js"],
      "run_at": "document_start",
      "all_frames": true
    },
    {
      "matches": ["<all_urls>"],
      "js": ["animation.js", "activation.js"],
      "run_at": "document_idle",
      "all_frames": false
    }
  ],
  "icons": {
    "16": "icons/logo-16.png",
    "32": "icons/logo-32.png",
    "48": "icons/logo-48.png",
    "128": "icons/logo-128.png"
  },
  "web_accessible_resources": [{
    "resources": ["assets/animation/*.png"],
    "matches": ["<all_urls>"],
    "use_dynamic_url": true
  }],
  "action": {
    "default_title": "NUTS",
    "default_icon": {
      "16": "icons/off-16.png",
      "32": "icons/off-32.png"
    }
  }
}
