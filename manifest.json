{
  "manifest_version": 3,
  "name": "No New Tabs",
  "version": "1.0.0",
  "description": "A one-click shield. While it is on, pages cannot open new tabs or send your tab to another site.",
  "minimum_chrome_version": "110",
  "permissions": ["storage", "webNavigation"],
  "background": {
    "service_worker": "background.js"
  },
  "icons": {
    "16": "icons/on-16.png",
    "32": "icons/on-32.png",
    "48": "icons/on-48.png",
    "128": "icons/on-128.png"
  },
  "action": {
    "default_title": "No New Tabs",
    "default_icon": {
      "16": "icons/off-16.png",
      "32": "icons/off-32.png"
    }
  }
}
