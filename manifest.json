{
  "manifest_version": 3,
  "name": "NUTS: No Unwanted Tabs or Swaps",
  "short_name": "NUTS",
  "version": "1.0.0",
  "description": "One switch. While it is on, pages cannot open new tabs or swap your tab for another site.",
  "minimum_chrome_version": "110",
  "permissions": ["storage", "webNavigation"],
  "host_permissions": ["<all_urls>"],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["site.js", "content.js"],
      "run_at": "document_start",
      "all_frames": true
    }
  ],
  "icons": {
    "16": "icons/on-16.png",
    "32": "icons/on-32.png",
    "48": "icons/on-48.png",
    "128": "icons/on-128.png"
  },
  "action": {
    "default_title": "NUTS",
    "default_icon": {
      "16": "icons/off-16.png",
      "32": "icons/off-32.png"
    }
  }
}
